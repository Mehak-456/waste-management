# ====================================================================
# Swachh Seva - Environment Configuration Template
# ====================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your project credentials from your Supabase Dashboard:
#      Project Settings -> API
# 3. Restart your development server:
#      npm run dev
# ====================================================================

# [Required] Your Supabase Project URL
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# [Required] Your Supabase Anon (public) Key
# SAFE to use in the browser. RLS policies secure the database.
# NEVER put your 'service_role' secret key here!
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
